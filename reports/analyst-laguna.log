import urllib.request, json

# Get v1.0 keys
try:
    resp = urllib.request.urlopen("https://login.microsoftonline.com/common/discovery/keys")
    v1_data = json.loads(resp.read())
    v1_kids = set(k['kid'] for k in v1_data.get('keys', []))
    print(f"v1.0 keys: {len(v1_kids)}")
    print(f"v1.0 kids: {sorted(v1_kids)}")
except Exception as e:
    print(f"v1.0 error: {e}")

# Get v2.0 keys
try:
    resp = urllib.request.urlopen("https://login.microsoftonline.com/common/discovery/v2.0/keys")
    v2_data = json.loads(resp.read())
    v2_kids = set(k['kid'] for k in v2_data.get('keys', []))
    print(f"v2.0 keys: {len(v2_kids)}")
    print(f"v2.0 kids: {sorted(v2_kids)}")
except Exception as e:
    print(f"v2.0 error: {e}")

# Check overlap
if 'v1_kids' in dir() and 'v2_kids' in dir():
    v1_only = v1_kids - v2_kids
    v2_only = v2_kids - v1_kids
    shared = v1_kids & v2_kids
    print(f"\nv1.0-only kids: {v1_only}")
    print(f"v2.0-only kids: {v2_only}")
    print(f"shared kids: {len(shared)}")
    print(f"v1 subset of v2: {v1_kids.issubset(v2_kids)}")
    
    # Check key types
    for k in v1_data.get('keys', []):
        if k['kid'] in v1_only:
            print(f"\nv1.0-only key: kid={k['kid']}, kty={k.get('kty')}, use={k.get('use')}")
    for k in v2_data.get('keys', []):
        if k['kid'] in v2_only:
            print(f"v2.0-only key: kid={k['kid']}, kty={k.get('kty')}, use={k.get('use')}")
