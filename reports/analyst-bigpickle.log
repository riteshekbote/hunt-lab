import { useAuth } from '@iamexperiences/feature-auth';
import { useMutation, useQuery } from 'react-query';
import { settingsManager } from '../../shared/settings';
import { IVerifiedCredential } from './Credential.type';

export const useRetrievingCredential = () => {
  const { auth } = useAuth();
  const url = `${settingsManager.get('myAccountBackendUrl')}/api/issueVerifiedEmployeeCredential`;
  const clientId = settingsManager.getRequired('clientId');

  return useMutation(async (): Promise<IVerifiedCredential> => {
    const token = await auth.acquireToken({ scopes: [clientId] });

    const response = await fetch(url, {
      method: 'POST',
      headers: {
        Authorization: `Bearer ${token}`,
        'Content-Type': 'application/json',
      },
    });

    if (!response.ok) {
      const error = await response.json();
      throw error;
    }

    const json = await response.json();
    return json as IVerifiedCredential;
  });
};

