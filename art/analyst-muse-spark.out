[0m
[0m$ [0mpython3 -c "
import json, urllib.request, re, collections
# fetch microsoft certspotter more fully and extract dns_names
import subprocess, json as j
import urllib.request, ssl
ctx = ssl.create_default_context()
try:
    with urllib.request.urlopen('https://api.certspotter.com/v1/issuances?domain=microsoft.com&expand=dns_names', timeout=20) as r:
        data = json.loads(r.read())
    hosts = set()
    for e in data:
        for h in e.get('dns_names', []):
            if h.startswith('*.'): continue
            if 'microsoft' in h or 'azure' in h or 'live' in h or 'office' in h or 'bing' in h or 'msn' in h:
                hosts.add(h)
    print('unique microsoft/azure hosts count', len(hosts))
    print(sorted(list(hosts))[:80])
except Exception as e:
    print('err', e)
