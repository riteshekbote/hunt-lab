[0m$ [0mcurl -s -m 15 "https://api.certspotter.com/v1/issuances?domain=microsoft.com&expand=dns_names" | python3 -c "
import json,sys,re
data=json.load(sys.stdin)
hosts=set()
for e in data:
  for n in e.get('dns_names',[]):
    n=n.strip().lower().lstrip('*.')
    # filter to probe_allow
    if re.search(r'(google|microsoft|azure|live|office|bing|msn)', n):
        hosts.add(n)
print('\n'.join(sorted(hosts)[:80]))
print(f'TOTAL_UNIQUE:{len(hosts)}', file=sys.stderr)
" 2>&1 | head -n 100
