[0m$ [0mcurl -s -m 15 "https://api.certspotter.com/v1/issuances?domain=microsoft.com&expand=dns_names" 2>&1 | python3 -c "
import json,sys
data=json.load(sys.stdin)
names=set()
for e in data:
    for n in e.get('dns_names',[]):
        names.add(n)
for n in sorted(names)[:100]:
    print(n)
print(f'TOTAL_UNIQUE:{len(names)}')
" 2>&1 | head -n 120

echo "--- google certspotter unique non-wildcard ---"
curl -s -m 15 "https://api.certspotter.com/v1/issuances?domain=google.com&expand=dns_names" 2>&1 | python3 -c "
import json,sys
data=json.load(sys.stdin)
names=set()
for e in data:
    for n in e.get('dns_names',[]):
        if not n.startswith('*.'):
            names.add(n)
for n in sorted(names):
    print(n)
print(f'TOTAL_UNIQUE_NONWILD:{len(names)}')
" 2>&1 | head -n 80

echo "--- liveness probes ---"
for h in www.google.com accounts.google.com www.microsoft.com login.microsoftonline.com portal.azure.com; do
  code=$(curl -s -o /dev/null -w "%{http_code}" -m 10 https://\$h/ 2>&1)
  echo "\$h -> \$code"
done
