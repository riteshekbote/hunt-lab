import json,subprocess,shlex
# parse certspotter for google
import urllib.request, json as j
try:
    data=json.loads(open('/tmp/g.json').read()) if False else None
    pass
except: pass
"
# fetch with more structured parsing: google CT dns_names dedup
curl -s -m 20 "https://api.certspotter.com/v1/issuances?domain=google.com&expand=dns_names&include_subdomains=true" | python3 -c "
import sys,json
try:
    data=json.load(sys.stdin)
except: data=[]
names=set()
for e in data:
    for n in e.get('dns_names',[]):
        # filter google.com
        if 'google.com' in n:
            names.add(n)
for n in sorted(names)[:100]:
    print(n)
print(f'TOTAL_GOOGLE_CT:{len(names)}', file=sys.stderr)
"

